# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgres://bookeasy:bookeasy@localhost:5432/bookeasy

# Redis
REDIS_URL=redis://localhost:6379

# Auth secrets (use long random values in real environments)
ACCESS_TOKEN_SECRET=change-me-with-a-32-char-minimum-secret
REFRESH_TOKEN_SECRET=change-me-with-a-32-char-minimum-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cookies
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Notifications (optional for MVP boot)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
EMAIL_FROM=
SMTP_URL=
